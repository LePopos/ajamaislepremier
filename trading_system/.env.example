# Alpha Vantage API Key (get from https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# TipRanks proxy URL (optional, for enhanced access)
TIPRANKS_PROXY_URL=

# Trading Configuration
MAX_POSITION_SIZE=1000.0
STOP_LOSS_PERCENTAGE=-5.0
MIN_SMART_SCORE=8
MAX_SMART_SCORE=3

# Risk Management
MAX_DAILY_TRADES=10
MAX_PORTFOLIO_RISK=0.02

# Data Collection
COLLECTION_INTERVAL_MINUTES=15
WATCHLIST=AAPL,MSFT,GOOGL,TSLA,NVDA,AMZN

# Database
DATABASE_URL=sqlite:///./trading_data.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_system.log

# Email Notifications
EMAIL_ENABLED=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_specific_password
RECIPIENT_EMAILS=trader1@example.com,trader2@example.com

# Webhooks (optional)
WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Notification Settings
SEND_SIGNAL_ALERTS=true
SEND_DAILY_SUMMARY=true
DAILY_SUMMARY_HOUR=18